# ============================================
# ECO-BOT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in all values
# DO NOT COMMIT .env TO VERSION CONTROL
# ============================================

# Discord Bot Token
# Get from: Discord Developer Portal → Your App → Bot → Copy Token
TOKEN=your_discord_bot_token_here

# MongoDB Connection String
# Local: mongodb://localhost:27017/eco-bot
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/eco-bot
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eco-bot

# Discord Application ID
# Get from: Discord Developer Portal → Your App → General Information
CLIENT_ID=1154063522188247121

# Your Discord Server ID (Guild ID)
# Right-click server → Copy Server ID (enable Dev Mode)
GUILD_ID=1154063522188247121

# External API Key (if using external services)
# Replace with your actual API key or leave as is if not needed
API_KEY=your_api_key_here

# Dashboard Web Server Port
# Port number for the web dashboard (typically 3000, 3001, 3002, etc.)
DASHBOARD_PORT=3000

# External Dashboard URL
# Use http://localhost:3000 for local development
# Use actual URL for production (e.g., https://yourdomain.com)
DASHBOARD_URL=http://localhost:3000

# Discord OAuth2 Client Secret
# Get from: Discord Developer Portal → Your App → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Session Secret
# Generate random string: openssl rand -hex 32
# Keep this secret and consistent across restarts
SESSION_SECRET=your_random_session_secret_key_here

# Your Discord User ID (for owner-only commands and admin dashboard)
# Right-click yourself in Discord → Copy User ID (enable Dev Mode)
OWNER_ID=1364717311386325043

# ============================================
# OPTIONAL SETTINGS (can be customized later)
# ============================================

# Bot Prefix (if using prefix commands - currently using slash commands)
# PREFIX=!

# Additional Owner IDs (comma-separated)
# SECONDARY_OWNER_ID=1312903688209301565

# Log Channel ID
# Right-click channel → Copy Channel ID (enable Dev Mode)
# LOG_CHANNEL_ID=1503785842425069659

# Order Channel ID
# ORDER_CHANNEL_ID=1503785880601497770

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Never share your TOKEN, MONGO_URI, or DISCORD_CLIENT_SECRET
# 2. Use unique SESSION_SECRET for each environment
# 3. For production, use strong, random secrets
# 4. Ensure MongoDB has network access (if using Atlas)
# 5. All IDs must be numeric strings (in quotes if needed)
# ============================================
