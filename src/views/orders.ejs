<body>
  <%
    const totalOrders = orders.length;
    const pendingOrders = orders.filter(o=>o.status === 'pending').length;
    const completedOrders = orders.filter(o=>o.status === 'completed').length;
    const cancelledOrders = orders.filter(o=>o.status === 'cancelled').length;
    const totalRevenue = orders.reduce((a,o)=>a+(o.totalPrice||0),0);
  %>
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><div class="brand-icon">📦</div><div><h1>Clover</h1><p>Order Command Center</p></div></div>
      <div class="nav-label">Main</div>
      <nav class="nav"><a href="/">📊 Dashboard</a><a href="/users">👥 Users</a><a class="active" href="/orders">📦 Orders</a><a href="/servers">🖥️ Servers</a><a href="/bulk">🧰 Bulk Tools</a><a href="/logout">🚪 Logout</a></nav>
      <div class="nav-label">Workflow</div>
      <div class="side-card"><b>Manual Fulfillment</b><span>Use this panel to update Forza credit order statuses after delivery.</span></div>
      <div class="side-card"><b>Refund Reminder</b><span>Dashboard status changes do not automatically refund. Use Discord cancel flow for refunds.</span></div>
    </aside>
    <main class="main">
      <div class="topbar"><div class="headline"><h2>Order Management</h2><p>Track, search, filter, and update external Forza orders.</p></div><div class="top-actions"><a class="btn" href="/">← Dashboard</a><button class="btn btn-blue" id="exportBtn" type="button">Export Visible</button><button class="btn btn-gold" id="refreshBtn" type="button">Refresh</button></div></div>
      <section class="hero"><div class="hero-grid"><div><h3>Forza Order Fulfillment Center</h3><p>Review pending orders, filter by customer/item/status, update fulfillment state, and inspect details for each order.</p><div class="top-actions"><button class="btn btn-gold" data-scroll="ordersPanel" type="button">View Orders</button><button class="btn btn-blue" id="pendingOnlyBtn" type="button">Pending Only</button><button class="btn btn-green" id="completedOnlyBtn" type="button">Completed Only</button></div></div><div class="hero-badge">📦</div></div></section>
      <section class="stats-grid">
        <div class="stat"><small>Total Orders</small><b><%= totalOrders.toLocaleString() %></b><span>All recorded orders</span></div>
        <div class="stat blue"><small>Pending</small><b><%= pendingOrders.toLocaleString() %></b><span>Awaiting delivery</span></div>
        <div class="stat green"><small>Completed</small><b><%= completedOrders.toLocaleString() %></b><span>Delivered orders</span></div>
        <div class="stat red"><small>Cancelled</small><b><%= cancelledOrders.toLocaleString() %></b><span>Stopped orders</span></div>
        <div class="stat purple"><small>Total Value</small><b><%= totalRevenue.toLocaleString() %></b><span>Coins spent on orders</span></div>
      </section>
      <section class="filters">
        <div class="field"><label>Search</label><input id="searchInput" placeholder="Search order, user, item..." /></div>
        <div class="field"><label>Status</label><select id="statusFilter"><option value="all">All</option><option value="pending">Pending</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></div>
        <div class="field"><label>Sort</label><select id="sortFilter"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="price-desc">Price high → low</option><option value="price-asc">Price low → high</option></select></div>
        <div class="field"><label>Minimum Cost</label><input id="minCost" placeholder="0" /></div>
        <div class="field"><label>Maximum Cost</label><input id="maxCost" placeholder="none" /></div>
      </section>
      <section class="panel" id="ordersPanel">
        <div class="panel-head"><h3>📦 External Orders</h3><span><span id="visibleCount"><%= orders.length %></span> visible orders</span></div>
        <div class="table-wrap">
          <table id="ordersTable">
            <thead><tr><th>Order ID</th><th>User</th><th>Item</th><th>Cost</th><th>Status</th><th>Claimed By</th><th>Created</th><th>Update</th><th>Details</th></tr></thead>
            <tbody>
              <% if (!orders.length) { %><tr><td colspan="9" class="empty">No orders found.</td></tr><% } %>
              <% orders.forEach((o, idx) => { const price = o.totalPrice || 0; const created = o.createdAt ? new Date(o.createdAt).getTime() : 0; %>
                <tr class="order-row" data-order="<%= o.orderId %>" data-user="<%= o.userId %>" data-item="<%= o.itemName %>" data-status="<%= o.status %>" data-price="<%= price %>" data-created="<%= created %>">
                  <td><span class="order-id"><%= o.orderId %></span></td>
                  <td><span class="user-id"><%= o.userId %></span><span class="sub">Customer</span></td>
                  <td><span class="item-name"><%= o.quantity %>x <%= o.itemName %></span><span class="sub">Item ID: <%= o.itemId || 'unknown' %></span></td>
                  <td class="money"><%= price.toLocaleString() %> coins</td>
                  <td><span class="status <%= o.status %>"><%= o.status %></span></td>
                  <td><% if (o.claimedBy) { %><span class="user-id"><%= o.claimedBy %></span><% } else { %><span class="sub">Not claimed</span><% } %></td>
                  <td><%= o.createdAt ? new Date(o.createdAt).toLocaleString() : 'Unknown' %></td>
                  <td><form class="control-form" method="POST" action="/orders/<%= o.orderId %>/status"><select name="status"><option value="pending" <%= o.status === 'pending' ? 'selected' : '' %>>pending</option><option value="completed" <%= o.status === 'completed' ? 'selected' : '' %>>completed</option><option value="cancelled" <%= o.status === 'cancelled' ? 'selected' : '' %>>cancelled</option></select><button class="btn btn-gold" type="submit">Update</button></form></td>
                  <td><button class="btn" type="button" data-drawer="order-drawer-<%= idx %>">Details</button></td>
                </tr>
                <tr class="drawer" id="order-drawer-<%= idx %>"><td colspan="9"><div class="drawer-content"><div class="detail-grid"><div class="detail-card"><small>Order ID</small><b><%= o.orderId %></b></div><div class="detail-card"><small>User</small><b><%= o.userId %></b></div><div class="detail-card"><small>Item</small><b><%= o.itemName %></b></div><div class="detail-card"><small>Quantity</small><b><%= o.quantity %></b></div><div class="detail-card"><small>Cost</small><b><%= price.toLocaleString() %></b></div><div class="detail-card"><small>Status</small><b><%= o.status %></b></div><div class="detail-card"><small>Claimed By</small><b><%= o.claimedBy || 'none' %></b></div><div class="detail-card"><small>Created</small><b><%= o.createdAt ? new Date(o.createdAt).toLocaleString() : 'Unknown' %></b></div></div><div class="timeline"><div class="timeline-item"><div class="timeline-icon">🛒</div><div><b>Order Created</b><span class="sub">Customer purchased an external Forza reward.</span></div></div><div class="timeline-item"><div class="timeline-icon">📦</div><div><b>Status: <%= o.status %></b><span class="sub">Update this order after manual delivery.</span></div></div><div class="timeline-item"><div class="timeline-icon">⚠️</div><div><b>Refund Notice</b><span class="sub">Dashboard cancellation changes status only. Use Discord cancel command for refunds.</span></div></div></div></div></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
      <div class="footer">Clover Orders Dashboard • Forza external order control</div>
    </main>
  </div>
  <div class="toast" id="toast">Done.</div>
  <script>
    const rows = [...document.querySelectorAll('.order-row')];
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const sortFilter = document.getElementById('sortFilter');
    const minCost = document.getElementById('minCost');
    const maxCost = document.getElementById('maxCost');
    const visibleCount = document.getElementById('visibleCount');
    const toast = document.getElementById('toast');
    function moneyNumber(value){ const n=Number(String(value||'').replace(/,/g,'').trim()); return Number.isFinite(n)?n:0; }
    function drawerFor(row){ const d=row.nextElementSibling?.classList?.contains('drawer')?row.nextElementSibling:null; return d; }
    function setVisible(row, visible){ row.style.display=visible?'':'none'; const d=drawerFor(row); if(d&&!visible)d.classList.remove('open'); if(d)d.style.display=visible&&d.classList.contains('open')?'table-row':'none'; }
    function applyFilters(){ const q=searchInput.value.toLowerCase().trim(); const st=statusFilter.value; const min=moneyNumber(minCost.value); const maxRaw=maxCost.value.trim(); const max=maxRaw?moneyNumber(maxRaw):Infinity; let count=0; rows.forEach(row=>{ const text=row.innerText.toLowerCase(); const status=row.dataset.status; const price=Number(row.dataset.price||0); const visible=text.includes(q)&&(st==='all'||status===st)&&price>=min&&price<=max; setVisible(row,visible); if(visible)count++; }); visibleCount.textContent=count; }
    function applySort(){ const type=sortFilter.value; const tbody=document.querySelector('#ordersTable tbody'); const pairs=rows.map(row=>({row,drawer:drawerFor(row)})); pairs.sort((a,b)=>{ if(type==='newest')return Number(b.row.dataset.created)-Number(a.row.dataset.created); if(type==='oldest')return Number(a.row.dataset.created)-Number(b.row.dataset.created); if(type==='price-desc')return Number(b.row.dataset.price)-Number(a.row.dataset.price); if(type==='price-asc')return Number(a.row.dataset.price)-Number(b.row.dataset.price); return 0; }); pairs.forEach(p=>{tbody.appendChild(p.row); if(p.drawer)tbody.appendChild(p.drawer);}); }
    searchInput.addEventListener('input', applyFilters); statusFilter.addEventListener('change', applyFilters); minCost.addEventListener('input', applyFilters); maxCost.addEventListener('input', applyFilters); sortFilter.addEventListener('change',()=>{applySort();applyFilters();});
    document.querySelectorAll('[data-drawer]').forEach(btn=>{btn.addEventListener('click',()=>{const d=document.getElementById(btn.dataset.drawer); d.classList.toggle('open'); d.style.display=d.classList.contains('open')?'table-row':'none';});});
    document.getElementById('pendingOnlyBtn').addEventListener('click',()=>{statusFilter.value='pending';applyFilters();});
    document.getElementById('completedOnlyBtn').addEventListener('click',()=>{statusFilter.value='completed';applyFilters();});
    document.getElementById('refreshBtn').addEventListener('click',()=>window.location.reload());
    document.querySelectorAll('[data-scroll]').forEach(btn=>btn.addEventListener('click',()=>document.getElementById(btn.dataset.scroll)?.scrollIntoView({behavior:'smooth'})));
    function visibleExport(){ const lines=['orderId,userId,item,status,totalPrice,createdAt']; rows.forEach(row=>{if(row.style.display==='none')return; lines.push([row.dataset.order,row.dataset.user,row.dataset.item,row.dataset.status,row.dataset.price,row.dataset.created].join(','));}); return lines.join('\n'); }
    function showToast(text){ toast.textContent=text; toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'),1800); }
    document.getElementById('exportBtn').addEventListener('click',()=>{const blob=new Blob([visibleExport()],{type:'text/csv'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download='clover-orders.csv'; a.click(); URL.revokeObjectURL(url); showToast('Export downloaded.');});
    applySort(); applyFilters();
  </script>
</body>
</html>