<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clover Orders</title>
  <style>
    :root {
      --bg: #070a0f;
      --panel: rgba(255,255,255,0.045);
      --panel2: rgba(255,255,255,0.075);
      --border: rgba(255,255,255,0.09);
      --text: #f4f7fb;
      --soft: #b6c0ce;
      --muted: #748093;
      --green: #57f287;
      --red: #ed4245;
      --gold: #ffd166;
      --blue: #5865f2;
      --purple: #9b5cff;
      --cyan: #4cc9f0;
      --shadow: 0 24px 70px rgba(0,0,0,.38);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin:0; min-height:100vh; color:var(--text); font-family:Inter,Arial,sans-serif; background: radial-gradient(circle at top right, rgba(255,209,102,.13), transparent 35%), radial-gradient(circle at bottom left, rgba(88,101,242,.16), transparent 35%), var(--bg); overflow-x:hidden; }
    a { color:inherit; text-decoration:none; }
    button,input,select,textarea { font-family:inherit; }
    .app { display:grid; grid-template-columns:280px 1fr; min-height:100vh; }
    .sidebar { position:sticky; top:0; height:100vh; padding:24px; background:rgba(12,16,24,.92); border-right:1px solid var(--border); backdrop-filter:blur(18px); z-index:20; }
    .brand { display:flex; align-items:center; gap:14px; margin-bottom:34px; }
    .brand-icon { width:54px; height:54px; border-radius:19px; display:grid; place-items:center; font-size:30px; background:linear-gradient(135deg,var(--gold),var(--purple)); box-shadow:0 0 45px rgba(255,209,102,.25); }
    .brand h1 { margin:0; font-size:23px; letter-spacing:-.04em; }
    .brand p { margin:4px 0 0; color:var(--muted); font-size:13px; }
    .nav-label { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.16em; margin:22px 0 10px 10px; }
    .nav { display:flex; flex-direction:column; gap:8px; }
    .nav a { padding:13px 14px; border-radius:15px; color:var(--soft); border:1px solid transparent; transition:.2s ease; }
    .nav a:hover,.nav a.active { background:rgba(255,255,255,.055); border-color:var(--border); color:white; transform:translateX(3px); }
    .nav a.active { background:linear-gradient(135deg,rgba(255,209,102,.18),rgba(155,92,255,.14)); border-color:rgba(255,209,102,.24); }
    .side-card { margin-top:26px; padding:16px; border-radius:18px; border:1px solid var(--border); background:rgba(255,255,255,.035); }
    .side-card b { display:block; margin-bottom:6px; }
    .side-card span { color:var(--muted); font-size:13px; line-height:1.45; }
    .main { padding:28px; }
    .topbar { display:flex; justify-content:space-between; align-items:center; gap:18px; margin-bottom:24px; }
    .headline h2 { margin:0; font-size:36px; letter-spacing:-.06em; }
    .headline p { margin:8px 0 0; color:var(--soft); }
    .top-actions { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .btn { border:1px solid var(--border); border-radius:14px; padding:11px 14px; color:white; font-weight:900; background:rgba(255,255,255,.06); cursor:pointer; transition:.2s ease; display:inline-flex; align-items:center; justify-content:center; gap:8px; }
    .btn:hover { transform:translateY(-2px); border-color:rgba(255,255,255,.16); }
    .btn-green { background:linear-gradient(135deg,var(--green),#35c96b); color:#06120b; }
    .btn-red { background:linear-gradient(135deg,var(--red),#b82d32); color:white; }
    .btn-blue { background:linear-gradient(135deg,var(--blue),var(--purple)); color:white; }
    .btn-gold { background:linear-gradient(135deg,var(--gold),#ffb703); color:#171004; }
    .hero { padding:26px; border-radius:30px; border:1px solid var(--border); background:linear-gradient(135deg,rgba(255,209,102,.16),rgba(155,92,255,.14)),rgba(255,255,255,.04); box-shadow:var(--shadow); margin-bottom:22px; overflow:hidden; position:relative; }
    .hero::before { content:''; position:absolute; width:260px; height:260px; right:-80px; top:-80px; border-radius:50%; background:rgba(255,209,102,.22); filter:blur(8px); }
    .hero-grid { position:relative; z-index:1; display:grid; grid-template-columns:1.3fr .7fr; gap:20px; align-items:center; }
    .hero h3 { margin:0; font-size:28px; letter-spacing:-.04em; }
    .hero p { color:var(--soft); line-height:1.6; max-width:760px; }
    .hero-badge { justify-self:end; width:150px; height:150px; border-radius:40px; display:grid; place-items:center; font-size:64px; background:linear-gradient(135deg,var(--gold),var(--purple)); box-shadow:0 30px 80px rgba(0,0,0,.35); }
    .stats-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:16px; margin-bottom:22px; }
    .stat { position:relative; overflow:hidden; padding:20px; border-radius:20px; border:1px solid var(--border); background:var(--panel); box-shadow:var(--shadow); }
    .stat::after { content:''; position:absolute; width:120px; height:120px; top:-55px; right:-55px; border-radius:50%; background:rgba(255,209,102,.22); }
    .stat.green::after { background:rgba(87,242,135,.22); }
    .stat.red::after { background:rgba(237,66,69,.18); }
    .stat.blue::after { background:rgba(88,101,242,.22); }
    .stat.purple::after { background:rgba(155,92,255,.22); }
    .stat small { position:relative; z-index:1; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; font-weight:900; font-size:11px; }
    .stat b { position:relative; z-index:1; display:block; margin-top:8px; font-size:28px; letter-spacing:-.05em; }
    .stat span { position:relative; z-index:1; display:block; margin-top:8px; color:var(--soft); font-size:12px; }
    .filters { display:grid; grid-template-columns:1.2fr repeat(4,minmax(140px,.45fr)); gap:12px; margin-bottom:18px; padding:16px; border-radius:22px; border:1px solid var(--border); background:rgba(255,255,255,.035); }
    .field label { display:block; color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.08em; margin-bottom:7px; font-weight:900; }
    .field input,.field select { width:100%; padding:12px 14px; border-radius:14px; border:1px solid var(--border); background:rgba(0,0,0,.24); color:white; outline:none; }
    .field input:focus,.field select:focus { border-color:rgba(255,209,102,.45); box-shadow:0 0 0 3px rgba(255,209,102,.1); }
    .panel { border-radius:24px; border:1px solid var(--border); background:var(--panel); box-shadow:var(--shadow); overflow:hidden; margin-bottom:22px; }
    .panel-head { padding:20px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:14px; }
    .panel-head h3 { margin:0; font-size:20px; letter-spacing:-.03em; }
    .panel-head span { color:var(--muted); font-size:13px; }
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; min-width:1350px; }
    th { padding:14px 16px; text-align:left; color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.08em; border-bottom:1px solid var(--border); background:rgba(0,0,0,.12); position:sticky; top:0; z-index:2; }
    td { padding:15px 16px; border-bottom:1px solid var(--border); color:var(--soft); vertical-align:middle; }
    tr:hover td { color:white; background:rgba(255,255,255,.025); }
    .order-id { font-family:Consolas,monospace; color:white; font-weight:900; background:rgba(255,255,255,.06); border:1px solid var(--border); padding:7px 10px; border-radius:10px; display:inline-block; }
    .user-id { font-family:Consolas,monospace; font-size:13px; color:var(--soft); }
    .item-name { color:white; font-weight:900; }
    .sub { display:block; color:var(--muted); font-size:12px; margin-top:4px; }
    .money { color:var(--green); font-weight:900; }
    .status { display:inline-flex; padding:7px 11px; border-radius:999px; font-size:12px; font-weight:900; text-transform:uppercase; border:1px solid transparent; }
    .status.pending { background:rgba(255,209,102,.12); color:var(--gold); border-color:rgba(255,209,102,.25); }
    .status.completed { background:rgba(87,242,135,.12); color:var(--green); border-color:rgba(87,242,135,.25); }
    .status.cancelled { background:rgba(237,66,69,.12); color:var(--red); border-color:rgba(237,66,69,.25); }
    .status.claimed { background:rgba(88,101,242,.12); color:var(--blue); border-color:rgba(88,101,242,.25); }
    .control-form { display:flex; gap:8px; align-items:center; min-width:270px; }
    .control-form select { padding:10px 12px; border-radius:12px; background:rgba(0,0,0,.24); border:1px solid var(--border); color:white; outline:none; }
    .drawer { display:none; background:rgba(255,255,255,.03); border-left:3px solid rgba(255,209,102,.45); }
    .drawer.open { display:table-row; }
    .drawer-content { padding:22px; }
    .detail-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
    .detail-card { padding:15px; border-radius:16px; border:1px solid var(--border); background:rgba(255,255,255,.035); }
    .detail-card small { color:var(--muted); text-transform:uppercase; letter-spacing:.08em; font-size:10px; font-weight:900; }
    .detail-card b { display:block; margin-top:7px; font-size:18px; }
    .timeline { display:grid; gap:12px; margin-top:18px; }
    .timeline-item { padding:14px; border-radius:16px; border:1px solid var(--border); background:rgba(255,255,255,.035); display:flex; gap:12px; align-items:flex-start; }
    .timeline-icon { width:38px; height:38px; border-radius:14px; display:grid; place-items:center; background:rgba(255,209,102,.12); color:var(--gold); flex:0 0 auto; }
    .toast { position:fixed; right:22px; bottom:22px; padding:14px 16px; border-radius:16px; border:1px solid var(--border); background:rgba(12,16,24,.95); color:white; box-shadow:var(--shadow); display:none; z-index:50; }
    .toast.show { display:block; animation:pop .25s ease; }
    @keyframes pop { from{transform:translateY(10px);opacity:0;} to{transform:translateY(0);opacity:1;} }
    .empty { padding:50px; text-align:center; color:var(--muted); }
    .footer { text-align:center; color:var(--muted); padding:20px; font-size:13px; }
    @media (max-width:1250px){.app{grid-template-columns:1fr}.sidebar{height:auto;position:relative;border-right:none;border-bottom:1px solid var(--border)}.stats-grid{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr 1fr}.hero-grid{grid-template-columns:1fr}.hero-badge{justify-self:start}.detail-grid{grid-template-columns:1fr 1fr}}
    @media (max-width:760px){.main{padding:18px}.topbar,.panel-head{flex-direction:column;align-items:flex-start}.stats-grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}}
