<body>
  <%
    const totalProfiles = users.length;
    const totalWallet = users.reduce((a,u)=>a+(u.wallet||0),0);
    const totalBank = users.reduce((a,u)=>a+(u.bank||0),0);
    const totalMoney = totalWallet + totalBank;
    const blacklistedCount = users.filter(u=>u.blacklisted).length;
    const flaggedCount = users.filter(u=>(u.flags||0)>0).length;
    const avgWallet = totalProfiles ? Math.floor(totalWallet / totalProfiles) : 0;
    const avgBank = totalProfiles ? Math.floor(totalBank / totalProfiles) : 0;
  %>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">🍀</div>
        <div>
          <h1>Clover</h1>
          <p>User Command Center</p>
        </div>
      </div>
      <div class="nav-label">Main</div>
      <nav class="nav">
        <a href="/">📊 Dashboard</a>
        <a class="active" href="/users">👥 Users</a>
        <a href="/orders">📦 Orders</a>
        <a href="/servers">🖥️ Servers</a>
        <a href="/bulk">🧰 Bulk Tools</a>
        <a href="/logout">🚪 Logout</a>
      </nav>
      <div class="nav-label">Tools</div>
      <div class="side-card">
        <b>Live MongoDB Controls</b>
        <span>Money edits, blacklist toggles, quick adjustments, and resets apply directly to your economy data.</span>
      </div>
      <div class="side-card">
        <b>Safety Reminder</b>
        <span>Use bulk actions carefully. This page is owner-only but it still edits real user profiles.</span>
      </div>
    </aside>
    <main class="main">
      <div class="topbar">
        <div class="headline">
          <h2>User Management</h2>
          <p>Search, filter, edit, blacklist, and inspect economy profiles.</p>
        </div>
        <div class="top-actions">
          <a class="btn" href="/">← Dashboard</a>
          <button class="btn btn-blue" type="button" id="exportBtn">Export Visible</button>
          <button class="btn btn-green" type="button" id="refreshBtn">Refresh</button>
        </div>
      </div>
      <section class="hero">
        <div class="hero-grid">
          <div>
            <h3>Economy Profiles Control Panel</h3>
            <p>Manage wallet and bank balances, review exploit flags, apply blacklists, inspect profiles, and search your user economy data in real time.</p>
            <div class="top-actions">
              <button class="btn btn-green" type="button" data-scroll="profilesPanel">View Profiles</button>
              <button class="btn btn-gold" type="button" data-scroll="bulkTools">Bulk Tools</button>
              <button class="btn btn-red" type="button" id="showBlacklistedBtn">Show Blacklisted</button>
            </div>
          </div>
          <div class="hero-badge">👥</div>
        </div>
      </section>
      <section class="stats-grid">
        <div class="stat"><small>Total Profiles</small><b><%= totalProfiles.toLocaleString() %></b><span>Users in this guild</span></div>
        <div class="stat green"><small>Total Wallet</small><b><%= totalWallet.toLocaleString() %></b><span>Coins held in wallets</span></div>
        <div class="stat"><small>Total Bank</small><b><%= totalBank.toLocaleString() %></b><span>Coins held in bank</span></div>
        <div class="stat gold"><small>Flagged Users</small><b><%= flaggedCount.toLocaleString() %></b><span>Profiles with flags</span></div>
        <div class="stat red"><small>Blacklisted</small><b><%= blacklistedCount.toLocaleString() %></b><span>Blocked users</span></div>
      </section>
      <section class="tool-panel" id="bulkTools">
        <div class="tool"><h4>⚡ Quick Editing</h4><p>Change wallet and bank values inline, then hit save for that user.</p><button class="btn btn-green" type="button" data-scroll="profilesPanel">Open Table</button></div>
        <div class="tool"><h4>🔍 Live Filtering</h4><p>Filter by user ID, status, flags, wealth range, and sorting preference.</p><button class="btn btn-blue" type="button" id="clearFiltersBtn">Clear Filters</button></div>
        <div class="tool"><h4>📤 Export</h4><p>Copy visible table rows into a quick CSV-style text export for records.</p><button class="btn btn-gold" type="button" id="copyExportBtn">Copy Export</button></div>
      </section>
      <section class="filters">
        <div class="field"><label>Search</label><input id="searchInput" placeholder="Search user ID, level, flags..." /></div>
        <div class="field"><label>Status</label><select id="statusFilter"><option value="all">All</option><option value="active">Active</option><option value="blacklisted">Blacklisted</option><option value="flagged">Flagged</option></select></div>
        <div class="field"><label>Sort</label><select id="sortFilter"><option value="total-desc">Total high → low</option><option value="wallet-desc">Wallet high → low</option><option value="bank-desc">Bank high → low</option><option value="flags-desc">Flags high → low</option><option value="level-desc">Level high → low</option><option value="total-asc">Total low → high</option></select></div>
        <div class="field"><label>Minimum Total</label><input id="minMoney" placeholder="0" /></div>
        <div class="field"><label>Maximum Total</label><input id="maxMoney" placeholder="none" /></div>
      </section>
      <div class="bulk-bar">
        <span><b id="visibleCount"><%= users.length %></b> visible users • Total visible wealth updates as filters change.</span>
        <div class="top-actions">
          <button class="btn" type="button" id="selectVisibleBtn">Select Visible</button>
          <button class="btn" type="button" id="clearSelectionBtn">Clear Selection</button>
          <button class="btn btn-red" type="button" id="warnBulkBtn">Bulk tools soon</button>
        </div>
      </div>
      <section class="panel" id="profilesPanel">
        <div class="panel-head">
          <h3>👥 Economy Profiles</h3>
          <span><span id="selectedCount">0</span> selected</span>
        </div>
        <div class="table-wrap">
          <table id="usersTable">
            <thead>
              <tr>
                <th>Select</th>
                <th>User</th>
                <th>Wallet</th>
                <th>Bank</th>
                <th>Total</th>
                <th>Level</th>
                <th>XP</th>
                <th>Streak</th>
                <th>Flags</th>
                <th>Status</th>
                <th>Money Controls</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!users.length) { %>
                <tr><td colspan="12" class="empty">No users found.</td></tr>
              <% } %>
              <% users.forEach((u, idx) => {
                   const wallet = u.wallet || 0;
                   const bank = u.bank || 0;
                   const total = wallet + bank;
                   const flags = u.flags || 0;
                   const level = u.level || 1;
                   const xp = u.xp || 0;
                   const streak = u.streak || 0;
              %>
                <tr class="user-row"
                    data-user="<%= u.userId %>"
                    data-wallet="<%= wallet %>"
                    data-bank="<%= bank %>"
                    data-total="<%= total %>"
                    data-flags="<%= flags %>"
                    data-level="<%= level %>"
                    data-status="<%= u.blacklisted ? 'blacklisted' : 'active' %>">
                  <td><input class="checkbox row-check" type="checkbox" /></td>
                  <td>
                    <div class="user-card">
                      <div class="mini-avatar"><%= String(u.username || u.userId).slice(0, 2).toUpperCase() %></div>
                      <div>
                        <span class="uid"><%= u.username || u.userId %></span>
                        <span class="sub">Profile #<%= idx + 1 %></span>
                      </div>
                    </div>
                  </td>
                  <td class="money"><%= wallet.toLocaleString() %></td>
                  <td class="bank"><%= bank.toLocaleString() %></td>
                  <td class="money"><%= total.toLocaleString() %></td>
                  <td><%= level %></td>
                  <td><%= xp.toLocaleString() %></td>
                  <td><%= streak %></td>
                  <td class="<%= flags > 0 ? 'gold-text' : '' %>"><%= flags %></td>
                  <td>
                    <% if (u.blacklisted) { %>
                      <span class="badge blacklisted">Blacklisted</span>
                    <% } else if (flags > 0) { %>
                      <span class="badge warn">Flagged</span>
                    <% } else { %>
                      <span class="badge active">Active</span>
                    <% } %>
                  </td>
                  <td>
                    <form class="control-grid" method="POST" action="/users/<%= u.userId %>/money">
                      <input name="wallet" value="<%= wallet %>" />
                      <input name="bank" value="<%= bank %>" />
                      <button class="btn btn-green" type="submit">Save</button>
                    </form>
                  </td>
                  <td>
                    <div class="action-row">
                      <form class="mini-form" method="POST" action="/users/<%= u.userId %>/money"><input type="hidden" name="wallet" value="<%= wallet + 1000 %>" /><input type="hidden" name="bank" value="<%= bank %>" /><button class="btn btn-blue" type="submit">+1k</button></form>
                      <form class="mini-form" method="POST" action="/users/<%= u.userId %>/money"><input type="hidden" name="wallet" value="<%= Math.max(0, wallet - 1000) %>" /><input type="hidden" name="bank" value="<%= bank %>" /><button class="btn btn-red" type="submit">-1k</button></form>
                      <form class="mini-form" method="POST" action="/users/<%= u.userId %>/blacklist"><button class="btn <%= u.blacklisted ? 'btn-green' : 'btn-red' %>" type="submit"><%= u.blacklisted ? 'Unblacklist' : 'Blacklist' %></button></form>
                      <button class="btn" type="button" data-drawer="drawer-<%= u.userId %>">Details</button>
                    </div>
                  </td>
                </tr>
                <tr class="drawer" id="drawer-<%= u.userId %>">
                  <td colspan="12">
                    <div class="drawer-content">
                      <div class="detail-grid">
                        <div class="detail-card"><small>Username</small><b><%= u.username || u.userId %></b></div>
                        <div class="detail-card"><small>Wallet</small><b><%= wallet.toLocaleString() %></b></div>
                        <div class="detail-card"><small>Bank</small><b><%= bank.toLocaleString() %></b></div>
                        <div class="detail-card"><small>Total</small><b><%= total.toLocaleString() %></b></div>
                        <div class="detail-card"><small>Level</small><b><%= level %></b></div>
                        <div class="detail-card"><small>XP</small><b><%= xp.toLocaleString() %></b></div>
                        <div class="detail-card"><small>Daily Streak</small><b><%= streak %></b></div>
                        <div class="detail-card"><small>Flags</small><b><%= flags %></b></div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
      <div class="footer">Clover Users Dashboard • Direct MongoDB economy management</div>
    </main>
  </div>
  <div class="toast" id="toast">Copied export to clipboard.</div>
  <script>
    const rows = [...document.querySelectorAll('.user-row')];
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const sortFilter = document.getElementById('sortFilter');
    const minMoney = document.getElementById('minMoney');
    const maxMoney = document.getElementById('maxMoney');
    const visibleCount = document.getElementById('visibleCount');
    const selectedCount = document.getElementById('selectedCount');
    const toast = document.getElementById('toast');
    function moneyNumber(value) { const n = Number(String(value || '').replace(/,/g, '').trim()); return Number.isFinite(n) ? n : 0; }
    function rowPair(row) { const drawer = row.nextElementSibling?.classList?.contains('drawer') ? row.nextElementSibling : null; return drawer; }
    function setRowVisible(row, visible) { row.style.display = visible ? '' : 'none'; const drawer = rowPair(row); if (drawer && !visible) drawer.classList.remove('open'); if (drawer) drawer.style.display = visible && drawer.classList.contains('open') ? 'table-row' : 'none'; }
    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      const status = statusFilter.value;
      const min = moneyNumber(minMoney.value);
      const maxRaw = maxMoney.value.trim();
      const max = maxRaw ? moneyNumber(maxRaw) : Infinity;
      let count = 0;
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const rowStatus = row.dataset.status;
        const total = Number(row.dataset.total || 0);
        const flags = Number(row.dataset.flags || 0);
        const matchesSearch = text.includes(query);
        const matchesStatus = status === 'all' || rowStatus === status || (status === 'flagged' && flags > 0);
        const matchesMoney = total >= min && total <= max;
        const visible = matchesSearch && matchesStatus && matchesMoney;
        setRowVisible(row, visible);
        if (visible) count++;
      });
      visibleCount.textContent = count;
      updateSelectedCount();
    }
    function applySort() {
      const [field, dir] = sortFilter.value.split('-');
      const tbody = document.querySelector('#usersTable tbody');
      const pairs = rows.map(row => ({ row, drawer: rowPair(row) }));
      pairs.sort((a,b) => {
        const av = Number(a.row.dataset[field] || 0);
        const bv = Number(b.row.dataset[field] || 0);
        return dir === 'asc' ? av - bv : bv - av;
      });
      pairs.forEach(pair => { tbody.appendChild(pair.row); if (pair.drawer) tbody.appendChild(pair.drawer); });
    }
    function updateSelectedCount() { selectedCount.textContent = document.querySelectorAll('.row-check:checked').length; }
    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    minMoney.addEventListener('input', applyFilters);
    maxMoney.addEventListener('input', applyFilters);
    sortFilter.addEventListener('change', () => { applySort(); applyFilters(); });
    document.querySelectorAll('[data-drawer]').forEach(btn => {
      btn.addEventListener('click', () => {
        const drawer = document.getElementById(btn.dataset.drawer);
        drawer.classList.toggle('open');
        drawer.style.display = drawer.classList.contains('open') ? 'table-row' : 'none';
      });
    });
    document.querySelectorAll('.row-check').forEach(box => box.addEventListener('change', updateSelectedCount));
    document.getElementById('selectVisibleBtn').addEventListener('click', () => { rows.forEach(row => { if (row.style.display !== 'none') row.querySelector('.row-check').checked = true; }); updateSelectedCount(); });
    document.getElementById('clearSelectionBtn').addEventListener('click', () => { document.querySelectorAll('.row-check').forEach(b => b.checked = false); updateSelectedCount(); });
    document.getElementById('clearFiltersBtn').addEventListener('click', () => { searchInput.value=''; statusFilter.value='all'; sortFilter.value='total-desc'; minMoney.value=''; maxMoney.value=''; applySort(); applyFilters(); });
    document.getElementById('showBlacklistedBtn').addEventListener('click', () => { statusFilter.value='blacklisted'; applyFilters(); });
    document.getElementById('refreshBtn').addEventListener('click', () => window.location.reload());
    document.querySelectorAll('[data-scroll]').forEach(btn => { btn.addEventListener('click', () => document.getElementById(btn.dataset.scroll)?.scrollIntoView({ behavior:'smooth' })); });
    function visibleExport() {
      const lines = ['userId,wallet,bank,total,level,xp,flags,status'];
      rows.forEach(row => {
        if (row.style.display === 'none') return;
        lines.push([row.dataset.user,row.dataset.wallet,row.dataset.bank,row.dataset.total,row.dataset.level,row.querySelectorAll('td')[6]?.innerText.trim(),row.dataset.flags,row.dataset.status].join(','));
      });
      return lines.join('\n');
    }
    function showToast(text) { toast.textContent = text; toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'), 1800); }
    document.getElementById('copyExportBtn').addEventListener('click', async () => { await navigator.clipboard.writeText(visibleExport()); showToast('Copied visible users export.'); });
    document.getElementById('exportBtn').addEventListener('click', () => { const blob = new Blob([visibleExport()], {type:'text/csv'}); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href=url; a.download='clover-users.csv'; a.click(); URL.revokeObjectURL(url); });
    document.getElementById('warnBulkBtn').addEventListener('click', () => showToast('Bulk destructive actions are intentionally disabled for safety.'));
    applySort();
    applyFilters();
  </script>
</body>
</html>